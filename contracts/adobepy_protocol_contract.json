    "BridgeSessionInfo": ["target", "capabilities", "connectedAtEpochMs"],
    "HostIdentityClaim": ["pid", "processStartIdentity", "executablePath", "hostVersion", "profileId"],
    "BridgeInstanceClaim": ["instanceId", "installedPluginRoot", "moduleOrigin"],
    "BridgeIdentityClaim": ["host", "bridge"],
    "BrokerRuntimeIdentity": ["pid", "processStartIdentity", "executablePath", "runtimeVersion", "instanceId"],
    "HostRuntimeIdentity": ["pid", "processStartIdentity", "executablePath", "hostVersion", "profileId"],
    "BridgeRuntimeIdentity": ["target", "bridgeKind", "bridgeVersion", "connectedAtEpochMs", "instanceId", "installedPluginRoot", "moduleOrigin"],
    "RuntimeIdentityAttestation": ["identityVersion", "broker", "host", "bridge"]
  },
  "bridgeInboundTypes": ["hello", "response", "error"],
  "bridgeOutboundTypes": ["request"],
  "pythonErrorClasses": {
    "ERROR_HOST_NOT_RUNNING": "HostNotRunningError",
    "ERROR_BRIDGE_NOT_INSTALLED": "BridgeNotInstalledError",
